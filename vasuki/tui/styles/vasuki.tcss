/* Vasuki TUI.
 *
 * A flat terminal surface: no panels, no boxed cards, no heavy borders.
 * Structure comes from hairline rules and spacing; meaning comes from colour,
 * with a hue per kind of message rather than a single grey ramp. Tokens mirror
 * vasuki/tui/palette.py — change both together.
 */

$background: #0a0d0b;
$rule: #252d27;
$accent: #72d895;
$prompt-accent: #86e7a6;
$prompt-rule: #33463a;

$input: #e2e8e1;
$bright: #ced5cd;
$text: #b7c0b7;
$muted: #7c877e;
$value: #909b92;
$hint: #626c64;
$dim: #59625b;
$faint: #49514b;
$faintest: #3a413c;

$ready: #64d98b;
$alert: #e2767f;
$caution: #e2b86b;

Screen {
    background: $background;
    color: $text;
    layers: base overlay;
}

/* ── header ─────────────────────────────────────────────────────────── */

#top-header {
    height: 4;
    padding: 1 2 0 2;
    background: $background;
    border-bottom: solid $rule;
}

.header-row {
    width: 100%;
    height: 1;
}

.header-left {
    width: 1fr;
    height: 1;
    color: $text;
}

.header-right {
    width: 1fr;
    height: 1;
    text-align: right;
}

/* ── navigation tabs ────────────────────────────────────────────────── */

#nav-tabs {
    height: 2;
    padding: 0 2;
    background: $background;
    border-bottom: solid $rule;
}

.nav-tab {
    width: auto;
    height: 1;
    margin-right: 1;
    color: $muted;
}

.nav-tab.active {
    background: #171d18;
    color: $accent;
}

.nav-tab:hover {
    background: #101511;
}

.nav-tab:focus {
    background: #171d18;
}

.nav-spacer {
    width: 1fr;
    height: 1;
}

.nav-more {
    width: auto;
    height: 1;
}

/* ── main surface ───────────────────────────────────────────────────── */

#workspace-body {
    width: 100%;
    height: 1fr;
    background: $background;
}

#main-workspace {
    width: 1fr;
    height: 100%;
    background: $background;
}

#task-checklist {
    width: 30;
    min-width: 24;
    height: 100%;
    padding: 1 2;
    border-left: solid $rule;
    background: $background;
    scrollbar-size: 1 1;
}

#runner-stage {
    width: 100%;
    height: 5;
    margin-bottom: 1;
}

#activity-label {
    width: 100%;
    height: 2;
    text-align: left;
    margin-bottom: 1;
}

#checklist-title {
    height: 2;
}

#checklist-items {
    width: 100%;
    height: auto;
}

.narrow #task-checklist {
    width: 28;
    min-width: 24;
    padding: 1;
}

.very-narrow #task-checklist {
    display: none;
}

#chat-view {
    width: 100%;
    height: 100%;
    padding: 1 2 0 2;
    scrollbar-size: 1 1;
}

#live-reasoning {
    width: 100%;
    max-width: 96;
    height: auto;
    max-height: 16;
    margin-bottom: 1;
    padding-left: 2;
    border-left: solid $rule;
    color: $muted;
    background: $background;
}

/* ── welcome ────────────────────────────────────────────────────────── */

.welcome-card {
    width: 100%;
    height: auto;
    padding-top: 1;
}

#welcome-help {
    height: auto;
}

.narrow #header-environment, .narrow #header-usage {
    display: none;
}

.narrow #top-header {
    height: 3;
}

.very-narrow #tab-qa-view, .very-narrow #tab-logs-view, .very-narrow #tab-map-view {
    display: none;
}

/* ── messages ───────────────────────────────────────────────────────── */

.message-card {
    width: 100%;
    max-width: 96;
    height: auto;
    margin-bottom: 1;
    padding: 0;
    background: $background;
    color: $text;
}

.message-card:focus {
    background: #101511;
}

/* ── context strip ──────────────────────────────────────────────────── */

#context-strip {
    height: 2;
    padding: 0 2;
    background: $background;
    border-top: solid $rule;
}

.hidden-panel, .hidden {
    display: none;
}

/* ── prompt ─────────────────────────────────────────────────────────── */

#prompt-area {
    height: auto;
    min-height: 4;
    max-height: 12;
    margin: 0;
    padding: 0 2;
    background: $background;
    border-top: solid $rule;
}

#prompt-area:focus-within {
    border-top: solid $prompt-rule;
}

#prompt-header {
    width: 100%;
    height: 1;
}

#prompt-title {
    width: auto;
    height: 1;
    color: $faint;
}

#prompt-meta {
    width: 1fr;
    height: 1;
    color: $faint;
    text-align: right;
}

#prompt-row {
    width: 100%;
    height: 2;
    min-height: 2;
}

#prompt-caret {
    width: 2;
    height: 100%;
    padding: 0;
    color: $prompt-accent;
}

#prompt {
    width: 1fr;
    height: 2;
    min-height: 2;
    padding: 0;
    border: none;
    background: $background;
    color: $input;
    scrollbar-size: 1 1;
}

#prompt:focus {
    border: none;
    background: $background;
}

#prompt-suggestions {
    height: auto;
    max-height: 6;
    background: $background;
    border: none;
    scrollbar-size: 1 1;
}

#prompt-suggestions ListItem {
    height: 1;
    padding: 0 1;
    background: $background;
    color: $muted;
}

#prompt-suggestions ListItem.-highlight {
    background: #101511;
    color: $bright;
}

#hint-bar {
    height: 2;
    dock: bottom;
    padding: 0 2 1 2;
    background: $background;
}

/* ── shared view chrome ─────────────────────────────────────────────── */

#missions-view, #qa-view, #repository-view, #files-view, #changes-view, #tests-view,
#approvals-view, #checkpoints-view, #playbooks-view, #deployments-view,
#providers-view, #settings-view, #logs-view, #map-view, #help-view {
    width: 100%;
    height: 100%;
    padding: 1 2 0 2;
}

#log-live-state {
    height: 2;
    color: $accent;
}

#log-live-content {
    height: 7;
    min-height: 4;
    border-bottom: solid $rule;
    margin-bottom: 1;
}

#log-content {
    height: 1fr;
}

#execution-map-layout {
    width: 100%;
    height: 1fr;
}

#map-prompt-panel {
    width: 46;
    min-width: 32;
    height: 100%;
    padding-right: 2;
    border-right: solid $rule;
}

#map-trace-panel {
    width: 1fr;
    height: 100%;
    padding-left: 2;
}

#map-trace-summary {
    width: 100%;
    height: auto;
    min-height: 3;
    padding-bottom: 1;
    color: $text;
    border-bottom: solid $rule;
}

#map-graph-scroll {
    width: 100%;
    height: 1fr;
    scrollbar-size: 1 1;
}

#map-graph {
    width: 100%;
    height: auto;
    padding-top: 1;
}

.narrow #map-prompt-panel {
    width: 36;
}

.very-narrow #execution-map-layout {
    layout: vertical;
}

.very-narrow #map-prompt-panel {
    width: 100%;
    min-width: 100%;
    height: 10;
    padding-right: 0;
    border-right: none;
    border-bottom: solid $rule;
}

.very-narrow #map-trace-panel {
    width: 100%;
    height: 1fr;
    padding-left: 1;
}

.view-title {
    height: 2;
    color: $bright;
    text-style: bold;
}

.section-title {
    height: 2;
    color: $faint;
}

.panel-title {
    height: 1;
    color: $faint;
}

.hint {
    height: 2;
    color: $faint;
}

DataTable {
    height: 1fr;
    background: $background;
    color: $text;
    border: none;
    scrollbar-size: 1 1;
}

DataTable > .datatable--header {
    background: $background;
    color: $faint;
    text-style: none;
}

DataTable > .datatable--cursor {
    background: #101511;
    color: $bright;
}

DataTable:focus > .datatable--cursor {
    background: #171d18;
    color: $bright;
}

DataTable:focus {
    border: none;
}

Tree {
    background: $background;
    color: $text;
    padding: 0;
}

Tree > .tree--guides, Tree > .tree--guides-hover, Tree > .tree--guides-selected {
    color: $rule;
}

Tree > .tree--cursor {
    background: #101511;
    color: $bright;
}

RichLog {
    background: $background;
    color: $text;
    scrollbar-size: 1 1;
}

Input, Select {
    background: $background;
    color: $input;
    border: none;
    border-bottom: solid $rule;
    padding: 0 1;
}

Input:focus, Select:focus {
    border: none;
    border-bottom: solid $accent;
}

Input > .input--placeholder {
    color: $faintest;
}

SelectCurrent {
    border: none;
}

SelectOverlay {
    background: #101511;
    border: none;
    color: $text;
}

Button {
    min-width: 10;
    height: 1;
    padding: 0 1;
    background: $background;
    color: $muted;
    border: none;
    text-style: none;
}

Button:hover {
    background: $background;
    color: $bright;
}

Button:focus {
    background: $background;
    color: $accent;
    text-style: bold;
}

Button.-primary, Button.-success, Button.-warning, Button.-error {
    background: $background;
    color: $accent;
}

.toolbar {
    height: 2;
    padding: 0;
    background: $background;
}

.toolbar Button {
    margin-right: 3;
}

.toolbar Select {
    width: 26;
}

/* ── providers ──────────────────────────────────────────────────────── */

#provider-form {
    height: 14;
    padding: 0;
    background: $background;
    border-bottom: solid $rule;
}

#provider-core-fields, #provider-detail-fields {
    height: 4;
    grid-size: 3 1;
    grid-columns: 1fr 1fr 1.2fr;
    grid-rows: 4;
    grid-gutter: 0 3;
}

/* Sized for the tallest visible combination: label plus the search box and
 * model picker. The plain model input and that pair are never shown together. */
#provider-detail-fields {
    height: 5;
    grid-size: 2 1;
    grid-columns: 1.7fr 1fr;
    grid-rows: 5;
}

.provider-field {
    height: 4;
}

.provider-model-field {
    height: 5;
}

.provider-field Label {
    height: 1;
    color: $faint;
}

.provider-field Input, .provider-field Select {
    height: 2;
    width: 100%;
}

#provider-actions {
    height: 2;
    align-horizontal: left;
}

#provider-actions Button {
    width: auto;
    margin-right: 4;
}

#provider-form-status {
    height: 2;
    color: $faint;
}

/* ── detail surfaces ────────────────────────────────────────────────── */

#mission-detail, #playbook-detail, #deployment-detail, #repository-summary {
    height: auto;
    max-height: 45%;
    padding: 1 0 0 0;
    background: $background;
    border-top: solid $rule;
    overflow-y: auto;
    scrollbar-size: 1 1;
}

#file-search, #log-filter {
    height: 2;
    margin: 0;
}

#file-browser {
    height: 1fr;
}

#file-tree {
    width: 34%;
    min-width: 22;
    height: 100%;
    padding-right: 2;
    border-right: solid $rule;
    background: $background;
}

#file-preview-panel {
    width: 1fr;
    height: 100%;
    padding-left: 2;
}

#file-outline {
    height: auto;
    max-height: 6;
    color: $faint;
    background: $background;
}

#file-preview-scroll, #diff-scroll {
    height: 1fr;
    scrollbar-size: 1 1;
}

#file-preview, #diff-content {
    width: auto;
    height: auto;
}

#diff-stats {
    height: 2;
    color: $faint;
}

#tests-table {
    height: 45%;
}

#test-failures {
    height: 1fr;
    padding-top: 1;
    background: $background;
    border-top: solid $rule;
}

#qa-state {
    height: 2;
    color: $faint;
}

#qa-scroll {
    width: 100%;
    height: 1fr;
    scrollbar-size: 1 1;
}

#qa-history-state {
    height: 1;
    color: $faint;
}

#qa-history {
    height: 8;
    min-height: 6;
}

#qa-specialists, #qa-checks {
    height: 11;
    min-height: 8;
}

#qa-report {
    height: auto;
    min-height: 12;
    padding: 0 1;
    background: $background;
    scrollbar-size: 1 1;
}

#settings-content {
    height: 1fr;
}

.very-narrow #file-tree {
    width: 24;
}

/* ── modals ─────────────────────────────────────────────────────────── */

ModalScreen {
    align: center middle;
    background: $background 80%;
}

#approval-dialog, #command-dialog, #model-dialog {
    width: 72;
    max-width: 92%;
    height: auto;
    max-height: 80%;
    padding: 1 2;
    background: #101511;
    border: solid $rule;
}

.modal-title {
    height: 2;
    text-style: bold;
    color: $accent;
}

.modal-actions {
    height: 3;
    margin-top: 1;
    align-horizontal: right;
}

.modal-actions Button {
    margin-left: 4;
}

#command-search {
    height: 2;
}

#command-options, #model-options {
    height: 18;
    max-height: 60%;
    background: #101511;
    border: none;
}

#command-options ListItem, #model-options ListItem {
    background: #101511;
    color: $muted;
    padding: 0 1;
}

#command-options ListItem.-highlight, #model-options ListItem.-highlight {
    background: #171d18;
    color: $bright;
}

/* ── onboarding ─────────────────────────────────────────────────────── */

OnboardingScreen {
    align: center middle;
}

#onboarding {
    width: 76;
    max-width: 92%;
    height: auto;
    max-height: 90%;
    padding: 1 3;
    background: $background;
    border: none;
}

#onboarding-logo {
    height: 2;
    text-align: left;
    text-style: bold;
    color: $accent;
}

.subtitle {
    height: 2;
    text-align: left;
    color: $faint;
}

#onboarding-summary {
    height: auto;
    margin-bottom: 1;
    padding: 0;
    background: $background;
    color: $muted;
}

#onboarding-error {
    height: auto;
    color: $alert;
}

#onboarding-loading {
    height: 1;
}

.onboarding-actions {
    height: 2;
    align-horizontal: left;
}

.onboarding-actions Button {
    margin-right: 4;
}

/* ── light theme ────────────────────────────────────────────────────── */

.theme-light {
    background: #f7f6f3;
    color: #4a4740;
}

.theme-light Screen,
.theme-light #workspace-body,
.theme-light #main-workspace,
.theme-light #chat-view,
.theme-light #top-header,
.theme-light #nav-tabs,
.theme-light #context-strip,
.theme-light #prompt-area,
.theme-light #hint-bar,
.theme-light #task-checklist,
.theme-light DataTable {
    background: #f7f6f3;
    color: #4a4740;
}
